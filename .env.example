# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local не попадает в git (см. .gitignore).

# URL веб-приложения Apps Script (Deploy -> New deployment -> Web app), вида
# https://script.google.com/macros/s/XXXXXXXX/exec
VITE_RSVP_SCRIPT_URL=

# Произвольная секретная строка. Должна совпадать со значением RSVP_SECRET
# в свойствах скрипта (Project Settings -> Script Properties).
# Это не настоящая защита (секрет попадает в клиентский бандл), а просто
# фильтр от случайных ботов, которые найдут URL скрипта.
VITE_RSVP_SECRET=
